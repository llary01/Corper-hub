<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>CorperHub – Log in</title>
<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@800&family=Figtree:wght@400;600;700&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#0f2a22;
  --ink:#0f2a22;
  --muted:#4b5a55;
  --green:#1e8250;
  --link:#17704a;
  --gold:#f5b335;
  --border:#c4c9c7;
}
*,*::before,*::after{box-sizing:border-box}
body{
  margin:0;min-height:100vh;background:var(--bg);
  font-family:"Figtree",system-ui,sans-serif;color:var(--ink);
  display:flex;flex-direction:column;align-items:center;
  padding:48px 20px;
}
.logo{
  font-family:"Archivo",sans-serif;font-weight:800;
  font-size:2rem;color:#fff;margin:0 0 30px;
}
.logo span{color:var(--gold)}
.card{
  width:100%;max-width:440px;background:#fff;
  border-radius:28px;padding:40px;
  box-shadow:0 20px 50px rgba(0,0,0,.35);
}
h1{font-family:"Archivo",sans-serif;font-weight:800;font-size:1.9rem;margin:0 0 14px}
.sub{margin:0 0 20px;color:var(--muted)}
.field{margin-bottom:16px}
.row{display:flex;justify-content:space-between;align-items:baseline}
label{display:block;font-weight:600;font-size:.95rem;margin-bottom:6px}
input{
  width:100%;height:52px;padding:0 16px;
  border:1px solid var(--border);border-radius:14px;
  font:inherit;font-size:1.05rem;
}
input::placeholder{color:#6b7672}
input:focus-visible{outline:3px solid rgba(30,130,80,.35);border-color:var(--green)}
a{color:var(--link);font-weight:600}
.row a{font-size:.9rem}
.btn{
  display:flex;align-items:center;justify-content:center;
  width:100%;height:52px;border-radius:14px;
  font:inherit;font-weight:700;font-size:1.05rem;
  cursor:pointer;text-decoration:none;
}
.btn-primary{background:var(--green);color:#fff;border:0}
.btn-primary:hover{background:#19724a}
.btn-outline{background:#fff;color:var(--ink);border:1px solid var(--ink)}
